# Copy to .streamlit/secrets.toml (never commit the copy), or paste the same
# keys into "App settings -> Secrets" on share.streamlit.io.

# Option 1 - the Anthropic API (what the app is built around).
ANTHROPIC_API_KEY = "sk-ant-..."

# Option 2 - any OpenAI-compatible gateway (Open WebUI, LiteLLM, vLLM, a
# university or company AI service). Used only when no Anthropic key is set.
# ELCAP_COMPAT_BASE_URL = "https://gateway.example.edu/api"
# ELCAP_COMPAT_API_KEY  = "sk-..."
# ELCAP_COMPAT_MODEL    = "claude-sonnet-5"
#
# If the gateway sits behind Cloudflare Access or a similar proxy, an API key
# alone will not get through - the request is bounced to a sign-in page before
# the gateway ever sees it. Add the service-token headers here:
# ELCAP_COMPAT_HEADERS = '{"CF-Access-Client-Id": "...", "CF-Access-Client-Secret": "..."}'
